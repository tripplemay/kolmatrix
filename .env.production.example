# BL-PROD-MIGRATE-DEPLOYSVR F-MIG-01 — deploysvr 生产 .env 模板（仅键名占位，禁真值入仓）。
# 落位：/opt/apps/kolmatrix/.env（chmod 600，不入 git）。真值从旧机 /opt/kolmatrix/.env.production
# 逐字迁移（H1/H2 红线：kolmatrix_app 密码五处一致 + NEXTAUTH_SECRET 保持不变，否则全体登出）。
# 数据库/Redis host 用 compose 服务名（postgres / redis），不是 localhost。

# ── compose 编排（docker compose ${...} 插值）───────────────────────────────
GH_REPO=tripplemay/kolmatrix
IMAGE_TAG=latest                       # 部署时由 deploy-prod.yml 覆盖为 <git-sha>；回滚换此值

# ── PostgreSQL（pgvector 容器）─────────────────────────────────────────────
POSTGRES_PASSWORD=__SUPERUSER_PASSWORD__            # kolmatrix superuser 密码（= DATABASE_ADMIN_URL 内密码）
KOLMATRIX_APP_PASSWORD=__APP_ROLE_PASSWORD__        # kolmatrix_app 应用角色密码（= DATABASE_URL 内密码；BL-043 五处一致）
# 运行时（app 走应用角色 kolmatrix_app，RLS 生效）
DATABASE_URL=postgresql://kolmatrix_app:__APP_ROLE_PASSWORD__@postgres:5432/kolmatrix?schema=public
# 迁移/seed（prisma CLI 走 superuser，可 DDL / 绕 RLS；见 prisma.config.ts）
DATABASE_ADMIN_URL=postgresql://kolmatrix:__SUPERUSER_PASSWORD__@postgres:5432/kolmatrix?schema=public

# ── Redis（专属容器，非共享 → db 0；BullMQ 队列 + 限流 + 缓存）────────────────
REDIS_URL=redis://redis:6379/0

# ── 认证（NextAuth）────────────────────────────────────────────────────────
NEXTAUTH_SECRET=__FROM_OLD_HOST__       # H2: 逐字沿用旧机值，否则全体会话失效
NEXTAUTH_URL=https://kol.guangai.ai
NEXT_PUBLIC_SITE_URL=https://kol.guangai.ai
SEED_ADMIN_PASSWORD=__FROM_OLD_HOST__   # 仅 db:seed 用；prod 已轮换，见 environment.md

# ── AI 网关（aigcgateway，走公网，同机但非内网耦合）────────────────────────────
AIGCGATEWAY_BASE_URL=https://aigc.guangai.ai
AIGCGATEWAY_API_KEY=__FROM_OLD_HOST__
# AIGC_TIMEOUT_MS=30000                 # 可选，默认见代码
AIGCGATEWAY_KOL_TOPIC_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_EXPLAIN_SHORT_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_EXPLAIN_DETAILED_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_REFINE_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_BRIEF_PARSE_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_KOL_COUNTRY_ACTION_ID=__FROM_OLD_HOST__
AIGCGATEWAY_MATCH_RERANK_ACTION_ID=__FROM_OLD_HOST__

# ── 邮件（Resend，合规发件）─────────────────────────────────────────────────
RESEND_API_KEY=__FROM_OLD_HOST__
RESEND_WEBHOOK_SECRET=__FROM_OLD_HOST__
# EMAIL_LOG_RETENTION_DAYS=90           # 可选

# ── KOL 采集（apify-kol-service，内网；F-MIG-03 随迁 deploysvr）───────────────
# ⚠️ 容器内 localhost:3004 ≠ 宿主。apify-kol 随迁后与本 app 共享 external docker 网络，
#    改为按容器名互访（F-MIG-03 最终确定服务名 + 端口）。占位如下：
APIFY_KOL_BASE_URL=http://apify-kol:3003
APIFY_KOL_BUSINESS_API_KEY=__FROM_OLD_HOST__
# APIFY_KOL_ADMIN_API_KEY=__FROM_OLD_HOST__   # KOLMatrix 侧一般不需要
YOUTUBE_API_KEY=__FROM_OLD_HOST__       # KOL 详情页 recent videos（B5-F006 保留）

# ── 运维 / 特性开关 ─────────────────────────────────────────────────────────
HEALTH_DETAIL_TOKEN=__FROM_OLD_HOST__   # /api/health 的 git_sha/version 明细门控（部署 curl 用）
AI_DAILY_COST_USD_PER_TENANT_MAX=5      # 每租户每日 AI 成本上限（BL-113）
ENABLE_AI_SEARCH=false                  # ?ai= 语义搜索开关（BL-112 未上线）
# HIDE_DEMO_SEED_KOLS=true              # 如需隐藏 demo 种子 KOL
# 以下限流开关 prod 一律不设（保持限流开启）：DISABLE_AI_RATELIMIT / DISABLE_BATCH_RATELIMIT / DISABLE_LOGIN_RATELIMIT
