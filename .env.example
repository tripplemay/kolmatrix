# ============================================================
# KOLMatrix — Local development environment template
# Copy to `.env` and fill in.
# ============================================================

# PostgreSQL 16 (via docker-compose up -d)
#
# Two connection strings intentionally:
#   - DATABASE_URL        = non-superuser app role, RLS enforced at runtime
#   - DATABASE_ADMIN_URL  = superuser for migrations / seed (bypasses RLS)
#
# The F004 migration (20260418010000_app_role) creates kolmatrix_app. Until
# that migration is applied you can reuse the admin URL for both values.
#
# BL-034 F001: app-role password is decoupled from migration history. Prod /
# staging rotate it via scripts/deploy-prod.sh from KOLMATRIX_APP_PASSWORD on
# every deploy (random 32-char per environment). Local dev: pick any value
# but it MUST match the password segment in DATABASE_URL below.
KOLMATRIX_APP_PASSWORD="CHANGEME-must-match-DATABASE_URL-password"
DATABASE_URL="postgresql://kolmatrix_app:CHANGEME-must-match-DATABASE_URL-password@localhost:5432/kolmatrix?schema=public"
DATABASE_ADMIN_URL="postgresql://kolmatrix:kolmatrix@localhost:5432/kolmatrix?schema=public"

# Redis 7 (reserved for BullMQ workers, F008+)
REDIS_URL="redis://localhost:6379/0"

# BL-034 F002 — optional override for `npm run db:seed` demo password.
# Local dev: leave unset, default "KOLMatrix@2026!" applies (with console.warn).
# BL-035-F001 raised the auth credentials min length to 12; the legacy
# "KOLM@2026!" (10 chars) no longer logs in.
# Prod: seed.ts hard-throws when NODE_ENV=production regardless of this var.
SEED_ADMIN_PASSWORD="KOLMatrix@2026!"

# NextAuth v5 (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# NEXTAUTH_URL is intentionally NOT set for local dev.
#
# next-auth's `reqWithEnvURL()` unconditionally rewrites req.nextUrl.origin
# to the env URL whenever NEXTAUTH_URL / AUTH_URL is set — this is
# independent of `trustHost`. If we hard-code http://localhost:3000 here,
# any dev server started on a different port (Codex uses 3099) emits
# redirects with Location: http://localhost:3000/... instead of the
# caller's real host, which breaks /login → /{locale}/login flows.
#
# Our auth.config.ts already sets `trustHost: true`, so when this env is
# unset NextAuth accepts the incoming Host header. CI and production set
# NEXTAUTH_URL explicitly via their own env files / workflow env block.
# NEXTAUTH_URL="http://localhost:3000"

# aigcgateway (AI scoring / email generation — B2+)
AIGCGATEWAY_BASE_URL="http://localhost:4000"
AIGCGATEWAY_API_KEY="replace-me-in-prod"

# Resend transactional email (B3+)
RESEND_API_KEY="replace-me-in-prod"

# BL-035-F006 — Resend webhook signing secret (Svix). Generate from
# the Resend dashboard → Webhooks → Endpoint signing secret. The
# webhook URL is `https://<host>/api/webhooks/resend`. When unset,
# `/api/webhooks/resend` returns 500 (not_configured) so prod cannot
# silently accept unsigned events.
RESEND_WEBHOOK_SECRET=""

# BL-034 F007 — gate /api/health detail (version, git_sha) behind a token.
# When unset, /api/health responds without these fields. When set, callers
# must send the same value via `?token=<value>` query string OR the
# `X-Health-Token` header. infrastructure/deploy-staging.sh +
# scripts/deploy-prod.sh post-deploy curl reads HEALTH_DETAIL_TOKEN from
# the same .env.* file. Recommended: openssl rand -hex 32.
HEALTH_DETAIL_TOKEN=""

# BL-034 F005 — per-tenant daily AI cost cap, USD. Default 5.00 when unset.
# Used by the per-tenant cost cap MVP (event_log 'ai.usage' counter); see
# spec §F005 + framework/harness/ai-action-contract.md §4. Staging may set
# a higher value (e.g. 100) to keep demo flow fluid; prod stays conservative.
AI_DAILY_COST_USD_PER_TENANT_MAX="5.00"

# BL-035-F003 — emergency escape hatches for AI / batch send rate limits.
# Set to "true" to short-circuit `rateLimitAi` (10/min/tenantId + 100/day)
# or `rateLimitBatchSend` (20/min/userId) to fail-open. Mirrors the
# DISABLE_LOGIN_RATELIMIT pattern from BL-020 F005. Leave empty in prod.
DISABLE_AI_RATELIMIT=""
DISABLE_BATCH_RATELIMIT=""

# BL-035-F007 — `[EMAIL MOCK]` log payload control. When unset/false the
# mock log includes only `to` + `subject`. Set to "true" on a developer
# machine to get the body preview back for copy iteration.
EMAIL_MOCK_VERBOSE="false"

# BL-020-F008 — set to "true" in production to hide demo_seed mock KOLs
# from the Discovery list. Cannot delete the seeds themselves: 300 EmailLog
# + 10 KolCampaign rows hold FKs onto them. Staging keeps this unset (or
# "false") so the demo flow remains exercisable.
HIDE_DEMO_SEED_KOLS="false"
