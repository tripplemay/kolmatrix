// KOLMatrix — B0 Foundation Prisma schema
// Reference: docs/specs/B0-database-schema.md §4
//
// All business tables carry tenant_id + RLS policies (installed via
// migration SQL). The migration SQL also bootstraps the auditable
// indexes and the soft-delete / updated_at triggers referenced by
// the acceptance criteria.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts.
// Schema only declares the provider.
datasource db {
  provider = "postgresql"
}

// ============================================================
//  Core multi-tenant tables
// ============================================================

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("free")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users             User[]
  kols              Kol[]
  campaigns         Campaign[]
  templates         EmailTemplate[]
  products          Product[]
  campaignMetrics   CampaignMetric[]
  weeklyReports     WeeklyReport[]
  savedSearches     SavedSearch[]
  assets            Asset[]
  kpiDailySnapshots KpiDailySnapshot[]

  @@map("tenant")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String    @unique
  emailVerified  DateTime? @map("email_verified") @db.Timestamptz
  hashedPassword String?   @map("hashed_password")
  name           String
  role           String    @default("marketer")
  locale         String    @default("en")
  image          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  accounts       Account[]
  sessions       Session[]
  campaignsOwned Campaign[]     @relation("CampaignOwner")
  weeklyReports  WeeklyReport[] @relation("WeeklyReportCreator")
  savedSearches  SavedSearch[]
  assetsCreated  Asset[]        @relation("AssetCreator")

  @@index([tenantId])
  @@map("user")
}

model SavedSearch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  filters   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("saved_search")
}

// ============================================================
//  NextAuth adapter tables
//  Conform to @auth/prisma-adapter expectations.
// ============================================================

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
//  KOL domain
// ============================================================

model Kol {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  platform           String
  handle             String
  displayName        String                   @map("display_name")
  bio                String?
  avatarUrl          String?                  @map("avatar_url")
  countryCode        String?                  @map("country_code")
  language           String?
  followerCount      Int                      @default(0) @map("follower_count")
  engagementRate     Decimal?                 @map("engagement_rate") @db.Decimal(7, 2)
  avgViews           Int?                     @map("avg_views")
  categories         String[]
  audienceAgeDist    Json?                    @map("audience_age_dist") @db.JsonB
  audienceGeoDist    Json?                    @map("audience_geo_dist") @db.JsonB
  audienceGenderDist Json?                    @map("audience_gender_dist") @db.JsonB
  aiScore            Int?                     @map("ai_score")
  aiScoreBreakdown   Json?                    @map("ai_score_breakdown") @db.JsonB
  aiEvaluatedAt      DateTime?                @map("ai_evaluated_at") @db.Timestamptz
  status             String                   @default("active")
  externalId         String?                  @map("external_id")
  // BL-082-F001 — platform-native user id (YouTube channel id "UC…",
  // TikTok/Instagram numeric ids), as emitted by the fork's
  // `platformUserId`. Distinct from `external_id` (the fork's own row id)
  // and `handle` (username; happens to equal the UC id for YouTube only).
  // The fork's single-profile refresh endpoint `GET /kol/:platform/:id`
  // keys on THIS value, so the daily refresh phase (F003) builds
  // `<platform>:<platformUserId>` ids from it. Nullable — older rows stay
  // NULL until F002's backfill populates them from the fork.
  platformUserId     String?                  @map("platform_user_id")
  lastSyncedAt       DateTime?                @map("last_synced_at") @db.Timestamptz
  // BL-081-F002 — one-shot "country enrichment attempted" marker. The
  // daily LLM country-enrichment stage sets this to NOW() whenever it
  // runs against a KOL (success OR null result), so the silent retry
  // storm (root cause R3) stops: a KOL is only re-attempted when fresher
  // source data arrives (last_synced_at > this). Nullable = "never
  // attempted" — the 2081 existing country_code-NULL rows stay NULL until
  // F005's one-shot backfill stamps them.
  countryEnrichmentAttemptedAt DateTime?      @map("country_enrichment_attempted_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz
  // BI4-F005: maintained by DB trigger kol_search_vector_trigger.
  // Declared so Prisma db pull does not drop the column; app code
  // never reads/writes it through the ORM — see
  // src/lib/search/tsvector.ts for the $queryRaw path.
  searchVector       Unsupported("tsvector")? @map("search_vector")

  // BM1-F001 extensions.
  // Skipped per adjudication #A: language / engagementRate (already in B0).
  // Re-used per #B: existing avgViews covers avgViewsPerVideo.
  // Re-used per #C: existing audienceAgeDist/GeoDist/GenderDist cover demographics.
  valueScore             Int?      @map("value_score")
  tags                   String[]  @default([])
  relationshipStatus     String    @default("prospect") @map("relationship_status") @db.VarChar(20)
  uploadsPerMonth        Int?      @map("uploads_per_month")
  lastUploadAt           DateTime? @map("last_upload_at") @db.Timestamptz
  monetizationStatus     String?   @map("monetization_status") @db.VarChar(20)
  brandSafetyRating      String?   @map("brand_safety_rating") @db.VarChar(8)
  knownBrandCollabs      String[]  @default([]) @map("known_brand_collabs")
  engagementAuthenticity Int?      @map("engagement_authenticity")
  isGaming               Boolean   @default(true) @map("is_gaming")
  aiTaggedAt             DateTime? @map("ai_tagged_at") @db.Timestamptz
  aiTagConfidence        String?   @map("ai_tag_confidence") @db.VarChar(8)

  // BM2-F001 extensions per audit #D/#E context (email outreach).
  email       String? @db.VarChar(320)
  // BL-083-F002 — email_source REUSED (not re-added): the existing
  // VARCHAR(20) already holds 'manual'; BL-083 adds the values
  // 'business-unlock' (fork Apify YT business email) and 'bio-regex'
  // (BL-031 bio extraction) alongside it. All three fit VARCHAR(20).
  emailSource String? @default("manual") @map("email_source") @db.VarChar(20)
  // BL-083-F002 — multi-email JSONB array unlocked by the fork's
  // yt-business-email Apify actor (`emails: string[]`). The legacy single
  // `email` column (above) only ever held 6 bio-regex values (0.8% of YT
  // KOLs); the fork has unlocked ~219 real business emails that the mapper
  // (F001) now surfaces here. Nullable additive column — no backfill at
  // apply time; F006's one-shot script promotes metadata.raw.emails into
  // it for existing rows, new/refreshed rows get it via the F003 upsert.
  emails Json? @map("emails") @db.JsonB

  // MVP-kol-seed-redo F003 — provenance JSONB. Holds is_demo flag for
  // the YouTube seed so a single DELETE WHERE metadata->>'is_demo'='true'
  // retires it when BL-012's crawler dataset lands. B5-kol-data-enrichment
  // promoted metadata.youtube.* (videoCount / totalViewCount /
  // channelCreatedAt / bannerUrl) into the dedicated columns below;
  // legacy rows retain their metadata.youtube.* payload for historical
  // reads but new code only writes the dedicated columns (A2 — no
  // double-write, see B5 spec §F002).
  metadata Json? @db.JsonB

  // B5-kol-data-enrichment F001 — promoted from metadata.youtube.*.
  // F002 backfills channelCreatedAt / videoCount / totalViewCount /
  // bannerUrl via channels.list and writes an estimated engagementRate;
  // F004 lazy-loads search.list/videos.list on detail-page open and
  // overwrites engagementRate with the true value (A1, see B5 spec
  // §F004 #4). All four columns are nullable — additive migration with
  // no backfill at apply time.
  channelCreatedAt DateTime? @map("channel_created_at") @db.Timestamptz
  videoCount       Int?      @map("video_count")
  totalViewCount   BigInt?   @map("total_view_count")
  bannerUrl        String?   @map("banner_url")

  // B6-kol-daily-sync F005 — UI hide flag for "suspicious_growth"
  // rows (follower count spiked 10× between syncs, likely fake-buy).
  // Audit trail stays in metadata.flags; this boolean is the
  // canonical filter the Discovery / Database UI checks.
  isSuspicious Boolean @default(false) @map("is_suspicious")

  // B7a-F001 — bge-m3 embedding (1024 dims) for Smart Match cosine.
  // Read/written via $queryRaw (Prisma Unsupported pattern, same as
  // searchVector above). Source text composition + re-embed policy:
  // see docs/specs/B7a-f001-embedding-preimpl-audit.md §9 #4 #6.
  embedding         Unsupported("vector(1024)")? @map("embedding")
  embeddingTextHash String?                      @map("embedding_text_hash")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  kolCampaigns KolCampaign[]
  emailLogs    EmailLog[]

  @@unique([tenantId, platform, handle])
  // MVP-kol-seed-redo F003 fix-round 1 — channel-id-based dedupe key.
  // YouTube channel.id is permanent; handle is mutable. Both
  // constraints stay live so legacy lookups (UI / search) keep
  // working while the YouTube import upserts on the stable id.
  @@unique([tenantId, platform, externalId], map: "kol_tenantId_platform_externalId_key")
  @@index([tenantId, aiScore(sort: Desc)])
  @@index([tenantId, platform, followerCount])
  @@index([tenantId, isGaming, valueScore(sort: Desc)], map: "kol_tenant_gaming_value_idx")
  // BL-081-F002 — drives the daily enrichment-stage WHERE that skips
  // already-attempted KOLs (tenant-scoped scan on the attempted marker).
  @@index([tenantId, countryEnrichmentAttemptedAt], map: "kol_tenant_country_attempted_idx")
  @@map("kol")
}

// ============================================================
//  Campaigns
// ============================================================

model Campaign {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  game            String?
  markets         String[]
  status          String    @default("draft")
  budgetAmount    Decimal?  @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency  String    @default("USD") @map("budget_currency")
  kpiTarget       Json?     @map("kpi_target") @db.JsonB
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  openRate        Decimal?  @map("open_rate") @db.Decimal(5, 4)
  // BM2-F001 extensions per audit #D (product_id TEXT, not UUID, to match Product.id cuid).
  productId       String?   @map("product_id") // FK product(id); matches cuid column type
  spendTotal      Decimal   @default(0) @map("spend_total") @db.Decimal(12, 2) // Σ kolCampaign.kolFee, maintained in app
  revenueRecorded Decimal?  @map("revenue_recorded") @db.Decimal(12, 2)
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  closedAt        DateTime? @map("closed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  owner           User             @relation("CampaignOwner", fields: [ownerUserId], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])
  kolCampaigns    KolCampaign[]
  emailLogs       EmailLog[]
  campaignMetrics CampaignMetric[]

  @@index([tenantId, status, startDate])
  @@index([tenantId, productId])
  @@index([tenantId, status, closedAt(sort: Desc)])
  @@map("campaign")
}

model KolCampaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  kolId          String    @map("kol_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  // BM2-F001 audit #E: default was "candidate" (B0); changed to "pending"
  // for the new 6-value contact lifecycle (pending/contacted/quoted/
  // signed/delivered/paid). Validated at zod level, not DB CHECK.
  status         String    @default("pending")
  matchScore     Int?      @map("match_score")
  matchReasoning Json?     @map("match_reasoning") @db.JsonB
  contactedAt    DateTime? @map("contacted_at") @db.Timestamptz
  repliedAt      DateTime? @map("replied_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // BM1-F001: BM2 will use this for negotiated KOL fees. match_score
  // stays as the existing B0 column (adjudication #A skip).
  kolFee         Decimal?  @map("kol_fee") @db.Decimal(10, 2)
  // BL-066-F004: provenance ("ai_smart_match" | "manual" | "csv_import" |
  // "manual_legacy"). Backfill default "manual" keeps pre-BL-066 rows
  // intact; AcceptedKolsPanel (F006) groups by this column for the
  // source chip.
  source         String    @default("manual") @db.VarChar(20)
  // BL-084-F003: AI Match Panel suggestion lifecycle (ADR-016). 4 states:
  //   suggested  — AI recalled + reranked this KOL for the campaign
  //   accepted   — marketer accepted (also the backfilled state for all
  //                pre-BL-084 rows, preserving BM1 "in this campaign")
  //   skipped    — marketer skipped (excluded from future suggestions)
  //   swap_pool  — moved to the candidate/bench column
  // Nullable: a NULL row predates the lifecycle (migration backfills it to
  // 'accepted'). match_score (above) is reused as the cosine score snapshot.
  suggestionStatus String?  @map("suggestion_status") @db.VarChar(20)
  // When the AI surfaced this row (NULL for legacy / manual rows).
  suggestedAt    DateTime? @map("suggested_at") @db.Timestamptz
  // When the marketer accepted/skipped/swapped (backfill = created_at).
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz

  kol      Kol      @relation(fields: [kolId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([tenantId, kolId, campaignId])
  @@index([tenantId, campaignId, status])
  // BL-035 F009 (DB-H5/H6): per-column indexes for the CRM "campaigns
  // featuring KOL X" lookup and the tenant_id RLS join key.
  @@index([kolId])
  @@index([tenantId])
  // BL-084-F003: three-column AI Match Panel query (WHERE campaign_id=X
  // AND suggestion_status=Y). Explicit map name so it matches the
  // evaluator's grep contract (kol_campaign_suggestion_status_idx).
  @@index([campaignId, suggestionStatus], map: "kol_campaign_suggestion_status_idx")
  @@map("kol_campaign")
}

// ============================================================
//  Email
// ============================================================

// BM2-F001 audit #A+#B: EmailTemplate table rebuilt (B0 shape dropped).
// Key change: tenantId is now nullable — rows with tenantId=null are
// "system" templates visible across tenants. App code reads via a union
// filter (tenantId=:tenant OR tenantId IS NULL).
model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  name      String
  subject   String
  body      String   @db.Text
  variables Json     @db.JsonB
  locale    String   @default("en") @db.VarChar(5)
  type      String   @default("system") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  emailLogs EmailLog[]

  @@index([tenantId, type])
  @@index([type, locale])
  @@map("email_template")
}

model EmailLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  campaignId        String?   @map("campaign_id") @db.Uuid
  kolId             String?   @map("kol_id") @db.Uuid
  templateId        String?   @map("template_id") @db.Uuid
  toAddress         String    @map("to_address")
  fromAddress       String    @map("from_address")
  subject           String
  bodyHtml          String    @map("body_html")
  provider          String    @default("resend")
  providerMessageId String?   @unique @map("provider_message_id")
  status            String    @default("queued")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz
  openedAt          DateTime? @map("opened_at") @db.Timestamptz
  repliedAt         DateTime? @map("replied_at") @db.Timestamptz
  bounceReason      String?   @map("bounce_reason")
  // BM2-F001 audit #F3: flag AI-customized sends for PRD §2.2 adoption metric.
  aiCustomized      Boolean   @default(false) @map("ai_customized")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  campaign Campaign?      @relation(fields: [campaignId], references: [id])
  kol      Kol?           @relation(fields: [kolId], references: [id])
  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, campaignId, status])
  @@index([tenantId, kolId])
  @@map("email_log")
}

// ============================================================
//  Audit
// ============================================================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  // BL-051a-F008: widened from UUID to VARCHAR(64) so product.deleted
  // audits (Product.id is a cuid, not a UUID) can write here. Same
  // shape as event_log.resource_id.
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  payload      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_log")
}

// ============================================================
//  Event log (BI4-F002)
//
//  Platform-level record of business events (kol.created,
//  campaign.email_sent, etc). Not tenant-scoped at the RLS layer:
//  readers are admin tooling and (future) webhook dispatchers. Writes
//  go through src/lib/events/log.ts which is fire-and-forget.
// ============================================================

model EventLog {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String   @db.VarChar(64)
  resourceId String?  @map("resource_id") @db.VarChar(64)
  payload    Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, type, createdAt])
  @@index([resourceId])
  @@map("event_log")
}

// ============================================================
//  Access requests (BAux1-F001)
//
//  Public intake for invite-only signup. Not tenant-scoped — rows are
//  created by anonymous visitors before any tenant/user exists, and are
//  only read by platform-admin tooling (see spec §F001). RLS therefore
//  does NOT apply here; read/write access is gated in application code.
// ============================================================

model AccessRequest {
  id                  String    @id @default(cuid())
  email               String    @unique @db.VarChar(320)
  firstName           String    @db.VarChar(64)
  lastName            String    @db.VarChar(64)
  company             String    @db.VarChar(128)
  role                String    @db.VarChar(64)
  campaignsPerQuarter String    @db.VarChar(32)
  games               String?   @db.Text
  wantsDemo           Boolean   @default(false)
  status              String    @default("pending") @db.VarChar(16)
  reviewedBy          String?   @db.VarChar(320)
  reviewedAt          DateTime?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("access_request")
}

// ============================================================
//  Products (BM1-F001)
//
//  Game products that tenants register in the Knowledge Base. Tenant-
//  scoped with an RLS policy (NULLIF-guarded, per database-patterns.md
//  §1). uniqueSellingPoints is required at the application layer (Zod)
//  because the AI asset generator collapses without it.
// ============================================================

model Product {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  category            String
  targetAudience      String    @map("target_audience") @db.Text
  uniqueSellingPoints String    @map("unique_selling_points") @db.Text
  downloadUrl         String?   @map("download_url")
  launchDate          DateTime? @map("launch_date") @db.Date
  // aiAssets shape:
  //   { emailTemplates: [{subject, body} × 3],
  //     videoScripts: [{title, script} × 2],
  //     generatedAt, cost?, traceId? }
  aiAssets            Json?     @map("ai_assets") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // B7a-F001 — bge-m3 embedding (1024 dims) for Smart Match cosine.
  // Source text: name + category + targetAudience + uniqueSellingPoints.
  // See docs/specs/B7a-f001-embedding-preimpl-audit.md §9 #5.
  embedding         Unsupported("vector(1024)")? @map("embedding")
  embeddingTextHash String?                      @map("embedding_text_hash")

  // BL-051a-F006 — soft delete. NULL = active row; non-NULL =
  // tombstoned (hidden from list/find queries via WHERE deleted_at IS
  // NULL filter; physical row + audit_log trail retained per ADR D5).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  assets    Asset[]

  @@index([tenantId])
  @@map("product")
}

// ============================================================
//  Campaign metrics (BM2-F001)
//
//  Time-series ROI input. MVP accepts manual entries; B2 will layer
//  automated sources (youtube-api / ga4). Tenant-scoped with the
//  NULLIF-guarded RLS policy; attributed revenue is signed decimal so
//  corrections can be recorded as negative rows.
// ============================================================

model CampaignMetric {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  impressions       Int?
  clicks            Int?
  conversions       Int?
  attributedRevenue Decimal? @map("attributed_revenue") @db.Decimal(12, 2)
  source            String   @default("manual") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, recordedAt(sort: Desc)])
  @@map("campaign_metric")
}

// ============================================================
//  Weekly reports (BM2-F001)
//
//  Snapshot of the AI-generated weekly brief. Stored as rendered
//  markdown plus the structured input used to build it (so the same
//  report can be re-rendered without calling the AI again). Share
//  tokens are opaque 32-char strings; BM2-F010's anonymous /shared/
//  route queries via a superuser connection that bypasses RLS, so the
//  standard NULLIF-guarded tenant policy still holds for in-app reads.
// ============================================================

model WeeklyReport {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  weekStart           DateTime  @map("week_start") @db.Date
  weekEnd             DateTime  @map("week_end") @db.Date
  locale              String    @default("en") @db.VarChar(5)
  contentMd           String    @map("content_md") @db.Text
  summaryJson         Json?     @map("summary_json") @db.JsonB
  shareToken          String?   @unique @map("share_token") @db.VarChar(32)
  shareTokenExpiresAt DateTime? @map("share_token_expires_at") @db.Timestamptz
  // BL-051a-F001 — explicit revocation timestamp. NULL = link active;
  // non-NULL = link revoked by owner (validateShareToken returns
  // status='revoked'). Independent of shareTokenExpiresAt so an
  // unexpired link can still be killed.
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId     String    @map("created_by_user_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("WeeklyReportCreator", fields: [createdByUserId], references: [id])

  @@unique([tenantId, weekStart, weekEnd, locale], map: "uq_weekly_report_tenant_week_locale")
  @@index([tenantId, weekEnd(sort: Desc)])
  @@map("weekly_report")
}

// ============================================================
// BIx-mvp-polish-pass F004-P2 · Daily-cron page-rotation cursor.
//
// Records the last `nextPageToken` returned by YouTube `search.list`
// for each (region, keyword) pair in the daily matrix so the cron
// can rotate page 1 → 2 → 3 over a 6-day cycle (see
// `pickDailyPage` + `pickDailyKeywords` in
// src/lib/kol-sync/adapters/youtube.ts). No tenant scope: discovery
// is platform-level, not tenant-owned.
// ============================================================

model KolSyncCursor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region        String
  keyword       String
  page          Int      @default(1) @db.SmallInt
  nextPageToken String?  @map("next_page_token")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([region, keyword], map: "kol_sync_cursor_region_keyword_key")
  @@map("kol_sync_cursor")
}

// ============================================================
// BL-025 · Unified Asset table (素材中心 / Asset Library)
//
// ADR-011 方案 X: single Asset table, type enum + content JSONB
// multipolymorphism, parentId for variant tree (regenerate without
// overwriting). EmailTemplate rows migrate in a follow-up
// migration; both tables coexist during a 1-sprint dual-write
// window (loadAssetsForComposer reads Asset, mutations.ts writes
// to both — see F006). The independent EmailTemplate cleanup
// migration lives outside BL-025.
//
// RLS policy: tenant_id IS NULL means system_seed visible across
// tenants (same shape as email_template's union policy). The Zod
// schemas in src/lib/assets/schemas.ts (F002) constrain the JSONB
// content per-type since Postgres can't enforce that shape.
// ============================================================

enum AssetType {
  email
  video_script
  ai_recommendation_explanation_short
  ai_recommendation_explanation_detailed
}

enum AssetSource {
  ai_generated
  user_created
  imported
  system_seed
}

enum AssetStatus {
  draft
  published
  archived
}

model Asset {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?     @map("tenant_id") @db.Uuid
  productId String?     @map("product_id")
  type      AssetType
  name      String      @db.VarChar(200)
  content   Json        @db.JsonB
  source    AssetSource
  parentId  String?     @map("parent_id") @db.Uuid
  status    AssetStatus @default(draft)
  metadata  Json        @default("{}") @db.JsonB
  createdBy String?     @map("created_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  parent        Asset?   @relation("AssetVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants      Asset[]  @relation("AssetVariants")
  createdByUser User?    @relation("AssetCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, type, status])
  @@index([tenantId, productId])
  @@index([parentId])
  @@map("asset")
}

// ============================================================
// BL-052 · Dashboard KPI daily snapshot (Part A · BL-050 BACKING)
//
// One row per (tenantId, snapshotDate) capturing the 5 KPI scalars
// computed at cron time. computeKpiTrend / computeSparkline read
// trailing N rows; UI fallback "—" + tooltip when < 7 snapshots
// (hasEnoughData=false). Cron entry: scripts/kpi-snapshot-daily.ts
// (chained after kol-sync-daily 08:30 BJ via /etc/cron.d).
// ============================================================

model KpiDailySnapshot {
  tenantId        String   @map("tenant_id") @db.Uuid
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  kolCount        Int      @map("kol_count")
  activeCampaigns Int      @map("active_campaigns")
  emailsSent7d    Int      @map("emails_sent_7d")
  productCount    Int      @map("product_count")
  avgValueScore   Decimal  @map("avg_value_score") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, snapshotDate])
  @@index([tenantId, snapshotDate(sort: Desc)], map: "kpi_daily_snapshot_recent_idx")
  @@map("kpi_daily_snapshot")
}
