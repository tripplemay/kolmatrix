# Harness agent local identity（本机身份，不入 git）
.agent-id

# Claude Code runtime locks
.claude/

# OS / editor
.DS_Store
*.swp
*.swo
.obsidian/

# Node / Next.js
node_modules/
.next/
dist/
build/
coverage/
.turbo/

# Env / secrets
.env
.env.local
.env.*.local
.env.production
.env.production.*
.env.staging
.env.staging.*

# Logs
*.log
npm-debug.log*

# Project scaffolding leftovers
_backup/

# Next build output
next-env.d.ts
*.tsbuildinfo

# docker-compose local overrides
docker-compose.override.yml
docker-compose.override.yaml

# Playwright artefacts (F010 will add tests/screenshots/baseline/ back in)
playwright-report/
test-results/
blob-report/
playwright/.cache/

# i18n translator dry-run reports — regenerated on every dry-run, not
# audit-worthy (live-run reports without the -dry suffix are committed).
docs/i18n/translate-report-*-dry.md

# B6 daily-sync operational reports — written on every cron run on
# prod / staging. Not audit material, and not portable across hosts.
docs/test-reports/kol-sync-daily-*.md
docs/test-reports/kol-quality-weekly-*.md
