{
  "name": "kolmatrix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:kol": "tsx scripts/seed-kol-from-enriched.ts",
    "seed:kol-youtube": "tsx scripts/seed-kol-from-youtube.ts",
    "seed:kol-youtube:dry": "tsx scripts/seed-kol-from-youtube.ts --dry-run",
    "validate:kol-enriched": "tsx scripts/validate-kol-from-enriched.ts",
    "validate:kol-enriched:dry": "tsx scripts/validate-kol-from-enriched.ts --dry-run",
    "import:kol-youtube": "tsx scripts/import-kol-from-youtube.ts",
    "import:kol-youtube:dry": "tsx scripts/import-kol-from-youtube.ts --dry-run",
    "enrich:kol-youtube": "tsx scripts/enrich-kol-from-youtube.ts",
    "enrich:kol-youtube:dry": "tsx scripts/enrich-kol-from-youtube.ts --dry-run",
    "kol-sync:daily": "tsx scripts/kol-sync-daily.ts",
    "kol-sync:daily:dry": "tsx scripts/kol-sync-daily.ts --dry-run",
    "kol-quality:weekly": "tsx scripts/kol-quality-weekly.ts",
    "kol-quality:weekly:dry": "tsx scripts/kol-quality-weekly.ts --dry-run",
    "kol-embed:backfill": "tsx scripts/kol-embed-backfill.ts",
    "kol-embed:backfill:dry": "tsx scripts/kol-embed-backfill.ts --dry",
    "seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "render:stitch-previews": "tsx scripts/render-stitch-previews.ts",
    "i18n:translate": "tsx scripts/i18n-translate.ts",
    "i18n:translate:dry": "tsx scripts/i18n-translate.ts --dry-run",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.99.0",
    "@visx/wordcloud": "4.0.1-alpha.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-cloud": "^1.2.9",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.9.1",
    "prisma": "^7.7.0",
    "rate-limiter-flexible": "^11.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.2",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
